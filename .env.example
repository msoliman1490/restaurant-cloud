# ==============================================================================
# Restaurant Cloud — Unified Environment Variables Specification
# Copy to .env for local development or configure in Staging/Production vaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Runtime Variables (apps/api — Docker Container)
# ------------------------------------------------------------------------------
NODE_ENV=staging
PORT=4000

# PostgreSQL 16 Application Connection (Must use non-superuser rc_app_user with RLS enforced)
DATABASE_URL=postgresql://rc_app_user:REPLACE_WITH_STRONG_RUNTIME_PASSWORD@db-host.internal:5432/restaurant_cloud

# Mandatory Cryptographic Key (Minimum 32 characters, required in production/staging)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_32_PLUS_CHARS_SECRET_KEY!

# Optional Previous Key (Used for zero-downtime secret rotation without logging out active users)
JWT_PREVIOUS_SECRET=

# Allowed CORS Origins (Comma-separated origins for web and cashier terminals)
CORS_ORIGINS=https://app.restaurantcloud.sa,https://staging.restaurantcloud.sa

# ------------------------------------------------------------------------------
# 2. Database Migration Variables (Independent CI/CD / Admin Execution Only)
# ------------------------------------------------------------------------------
# Used ONLY by drizzle-kit during deployment pipelines. Never accessed by application runtime.
# Must use rc_admin role with DDL privileges.
DATABASE_ADMIN_URL=postgresql://rc_admin:REPLACE_WITH_ADMIN_PASSWORD@db-host.internal:5432/restaurant_cloud

# ------------------------------------------------------------------------------
# 3. Cloudflare Pages Variables (apps/web — Edge Environment)
# ------------------------------------------------------------------------------
# Target container origin URL for Edge Function reverse proxy (/api/* -> Backend)
BACKEND_ORIGIN_URL=https://api-backend.restaurantcloud.sa

# Cloudflare Pages Build Environment
NODE_VERSION=22
