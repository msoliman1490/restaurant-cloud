# Node environment
NODE_ENV=development
PORT=4000

# Runtime Database Connection (Least Privilege Application Role - NO SUPERUSER, NO BYPASSRLS)
DATABASE_URL=postgresql://rc_app_user:rc_app_user_password_2026@localhost:5432/restaurant_cloud_dev?sslmode=disable
DATABASE_POOL_URL=postgresql://rc_app_user:rc_app_user_password_2026@localhost:5432/restaurant_cloud_dev?sslmode=disable

# Migration & Schema Owner Connection (Used ONLY by Drizzle Kit / CI/CD Migration Runner)
MIGRATION_DATABASE_URL=postgresql://rc_admin:rc_secure_dev_password_2026@localhost:5432/restaurant_cloud_dev?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Authentication & Secrets (Minimum 32 characters in production)
JWT_SECRET=super_secret_jwt_key_restaurant_cloud_dev_2026_min_32_chars
JWT_PREVIOUS_SECRET=
JWT_EXPIRES_IN=1d

# ZATCA Sandbox Settings
ZATCA_ENV=sandbox
ZATCA_SIMULATION_MODE=true
